diff --git a/lite/gym/utils/config/naming.py b/lite/gym/utils/config/naming.py
index ea7b10e..f9bbdb7 100644
--- a/lite/gym/utils/config/naming.py
+++ b/lite/gym/utils/config/naming.py
@@ -38,6 +38,24 @@ from lite.gym.utils.backend.ports import env_server_scope
 
 _PREFIX = "lite-env"
 
+# cc(luojiaxuan): shared-host anonymity — benchmark-identifying name segments
+# are aliased at this single grammar point; match_pattern applies the same
+# alias so the reaper stays coherent. See cc_recipe/patches/.
+_CC_ENV_ALIAS = {
+    "mobileworld": "e2", "osworld": "e3", "androidworld": "e4",
+    "lite.osworld": "e5", "osworld_2": "e6", "osworld_g": "e7",
+    "androidlab": "e8", "mobilegym": "e9",
+}
+
+
+def _cc_env(env_id):
+    return _CC_ENV_ALIAS.get(env_id, env_id)
+
+
+def _cc_task(task_id):
+    import hashlib
+    return hashlib.sha256(task_id.encode()).hexdigest()[:8]
+
 # Docker container names allow ``[a-zA-Z0-9][a-zA-Z0-9_.-]*``; sanitize
 # task_ids (which can contain arbitrary punctuation) to that charset.
 _DOCKER_NAME_SAFE_CHARS = frozenset("_.-")
@@ -124,9 +142,9 @@ def format_container_name(
     """
     parts: list[str] = [_sanitize_session_id(session_id) if session_id else "local"]
     if env_id:
-        parts.append(env_id)
+        parts.append(_cc_env(env_id))
     if task_id:
-        parts.append(_sanitize_task_id(task_id))
+        parts.append(_cc_task(_sanitize_task_id(task_id)))
     parts.append(suffix)
     return container_name_prefix(
         server_port=server_port, token_hash=token_hash
@@ -188,7 +206,7 @@ def match_pattern(prefix: str, env_id: str) -> str:
     ambiguous — and per-instance precision must come from
     ``env.external_resource_id`` (exact match), never from name parsing.
     """
-    return f"^{prefix}.*-{re.escape(env_id)}-"
+    return f"^{prefix}.*-{re.escape(_cc_env(env_id))}-"
 
 
 # ── Singleton shared-container scheme (webgym / mobilegym SINGLETON) ────────────
