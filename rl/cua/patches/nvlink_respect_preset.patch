# note (luojiaxuan): 共享 H200(hyper00)的 Fabric Manager/NVSwitch 不支持
# NVLS 多播绑定(CUDA error 401),而上游 nvlink.sh 探到 NVLink 边就强开
# NCCL_NVLS_ENABLE=1 且无覆盖口。此补丁让预设 HAS_NVLINK 生效
# (发射侧 -e HAS_NVLINK=0),未预设时行为不变。应用于 CUA-Lite@2602509
# 的工作 checkout;可回流上游。
--- a/scripts/train/utils/nvlink.sh
+++ b/scripts/train/utils/nvlink.sh
@@ -10,11 +10,16 @@
 #
 # Sets HAS_NVLINK to 1 if `nvidia-smi topo -m` reports any NVLink edges.
 
+if [ -n "${HAS_NVLINK:-}" ]; then
+   echo "HAS_NVLINK: ${HAS_NVLINK} (preset by caller; probe skipped)"
+else
 _NVLINK_COUNT=$(nvidia-smi topo -m 2>/dev/null | grep -o 'NV[0-9][0-9]*' | wc -l)
 if [ "$_NVLINK_COUNT" -gt 0 ]; then
    HAS_NVLINK=1
 else
    HAS_NVLINK=0
 fi
 echo "HAS_NVLINK: $HAS_NVLINK (detected $_NVLINK_COUNT NVLink references)"
 unset _NVLINK_COUNT
+fi
