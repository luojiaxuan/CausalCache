      "mode": "fixed_token_target",
      "target_effective_tokens_per_image": 2560,
      "record_actual_image_grid_and_tokens": true
    }
  },
  "reference_definition": {
    "mode": "stable_full_history_self_behavior",
    "expert_top1_match_required": false,
    "summary_present_for_every_history_event": true,
    "confirm_decision_step_id": 6,
    "history_event_step_ids": [1, 2, 3, 4, 5],
    "current_equivalent_event_step_id": 5,
    "observation_identity": "artifact_image_member_path_and_sha256",
    "reference_high_fidelity_event_step_ids": [1, 2, 3, 4],
    "reference_history_images": 4,
    "current_observation_images": 1,
    "total_reference_images": 5,
    "reference_contains_every_distinct_post_state_image": true,
    "canonical_action_path": "native_envelope_with_fixed_nonsemantic_action_carrier_and_normalized_mobile_use_tool_call",
    "teacher_forced_action_carrier": "Action: Execute the selected mobile action.\n",
    "canonical_tool_call_serialization": {
      "opening": "<tool_call>\n",
      "top_level_key_order": ["name", "arguments"],
      "name": "mobile_use",
      "argument_key_order": ["action", "coordinate", "coordinate2", "text", "button", "status"],
      "omit_absent_arguments": true,
      "text_normalization": "Unicode_NFKC",
      "coordinate_number_format": "base10_integer",
      "json": "ensure_ascii_false_separators_comma_colon",
      "closing": "\n</tool_call>"
    },
    "teacher_forced_context": "processor_native_assistant_prefix_plus_fixed_action_carrier",
    "distance_token_span": "first_token_of_<tool_call>_through_final_token_of_</tool_call>_inclusive",
    "distance": "teacher_forced_full_vocabulary_mean_kl_on_distance_token_span",
    "parse_required": true,
    "finite_logits_required": true,
    "repeat_forwards": 2,
    "repeat_canonical_action_match_required": true,
    "repeat_noise_epsilon": "max(1e-4,10*mean_repeat_kl)"
  },
  "quality_reporting": {
    "may_filter_label_or_confirm_states": false,
    "rollout_outcome_axis": [
      "successful_self_rollout",
      "failed_self_rollout",
      "not_available"
    ],
    "source_trajectory_axis": [
      "expert_success_trajectory",
      "self_rollout_trajectory",
      "not_available"
    ],
    "expert_alignment_axis": [
      "semantic_expert_match",
      "canonical_bin_match",
      "action_type_match_only",
      "expert_mismatch",
      "not_available"
    ],
    "semantic_match_requires_preoutput_ui_target_annotation": true,
    "always_report": [
      "action_type_match",
      "canonical_bin_match",
      "normalized_coordinate_distance",
      "text_argument_match"
    ]
  },
  "action_contract": {
    "contract_id": "gui_owl_androidworld_v2",
    "output_envelope": "one_Action_line_then_one_mobile_use_tool_call",
    "inventory_equality_scope": "normalized_policy_visible_effective_inventory_after_bridge",
