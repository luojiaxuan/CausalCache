    "serialization": "compact_utf8_json_ensure_ascii_false_separators_comma_colon_then_newline",
    "missing_scalar_value": "unknown",
    "present_for_every_event_in_every_memory": true,
    "byte_identical_between_low_and_high_fidelity": true,
    "action_argument": {
      "spatial_action": "10x10_coordinate_bin",
      "swipe": "viewport_direction_and_displacement_bin",
      "text_open_answer": "exact_nfkc_text",
      "system_button": "exact_button",
      "wait": "wait"
    },
    "screen_text_delta": {
      "source": "accessibility_tree_else_pinned_ocr",
      "normalization": "Unicode_NFKC_collapse_whitespace_strip",
      "ordering": "top_to_bottom_then_left_to_right",
      "maximum_added_tokens": 32,
      "maximum_removed_tokens": 32,
      "truncation": "keep_first_tokens_in_frozen_spatial_order_and_record_discarded_count_in_artifact_metadata",
      "backend_revision_and_model_hash_required_in_execution_config": true
    },
    "foreground_app": {
      "source": "source_app_label_else_executor_package_name_else_unknown",
      "normalization": "Unicode_NFKC_collapse_whitespace_strip_casefold"
    },
    "screen_change": {
      "metric": "mean_absolute_rgb_difference_after_256x256_bilinear_resize_in_[0,1]",
      "bins": {
        "none": "value<=0.005",
        "low": "0.005<value<=0.05",
        "medium": "0.05<value<=0.20",
        "high": "value>0.20"
      },
      "library_version_and_resampling_identity_required_in_execution_config": true
    },
    "executor_result_values": [
      "accepted",
      "failed",
      "unknown"
    ],
    "executor_result_provenance": "accepted_or_failed_only_from_executor_record_else_unknown_never_inferred_from_pixels",
    "exact_text_argument_is_not_truncated": true,
    "context_overflow_outcome": "INVALID_BEFORE_POLICY_FORWARD",
    "report_policy_visible_text_tokens": true
  },
  "high_fidelity_event": {
    "images_per_event": 1,
    "image": "post_action_state",
    "include_before_image": false,
