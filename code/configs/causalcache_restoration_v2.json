    "unsupported_prompt_actions_allowed": false,
    "canonical_prompt_actions": [
      "click",
      "long_press",
      "swipe",
      "type",
      "system_button",
      "open",
      "wait",
      "answer",
      "terminate"
    ],
    "system_buttons": [
      "Back",
      "Home",
      "Enter"
    ],
    "accepted_model_aliases": {
      "tap": "click",
      "open_app": "open"
    },
    "removed_upstream_actions": [
      "key",
      "system_button:Menu"
    ],
    "coordinate_contract": {
      "normalized_minimum": 0,
      "normalized_maximum": 999,
      "pixel_scaling": "floor(value*(extent-1)/999+0.5)",
      "pixel_output_must_be_strictly_inside_extent": true
    },
    "parameter_contract": {
      "click": ["coordinate"],
      "long_press": ["coordinate"],
      "swipe": ["coordinate", "coordinate2"],
      "type": ["text"],
      "system_button": ["button"],
      "open": ["text"],
      "wait": [],
      "answer": ["text"],
      "terminate": ["status=success"]
    },
    "exact_native_tool_call_preserved_in_archive": true,
    "exact_androidworld_payload_preserved_in_archive": true,
    "exhaustive_round_trip_fixture_required": true,
    "exhaustive_round_trip_pass_rate": 1.0,
    "empirical_development_parse_coverage_minimum": 0.99
  },
  "low_fidelity_event": {
    "schema_version": "2.0.0",
    "serialized_key_order": [
      "step_id",
      "action_type",
      "action_argument",
      "foreground_app",
      "screen_text_added",
      "screen_text_removed",
      "screen_change",
      "executor_result"
