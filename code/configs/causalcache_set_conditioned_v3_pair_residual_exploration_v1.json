    "formal_oof_required_variants": ["additive", "unguarded_pair_residual", "safe_pair_residual"],
    "fresh16_required_variants": ["additive", "unguarded_pair_residual", "safe_pair_residual", "historical_independent", "exact_subset_oracle"],
    "fresh16_primary_contrast": "safe_pair_residual_minus_additive",
    "fresh16_reports_raw_and_normalized": true,
    "fresh16_reports_trajectory_paired_bootstrap": true,
    "fresh16_reports_n2_n3_n4_strata": true,
    "fresh16_reports_safe_fallback_rate": true,
    "fresh16_is_development_only": true,
    "development_interpretation_rule": {
      "primary_contrast": "safe_pair_residual_minus_additive",
      "all_conditions_required_for_promising": true,
      "minimum_mean_normalized_delta": 0.01,
