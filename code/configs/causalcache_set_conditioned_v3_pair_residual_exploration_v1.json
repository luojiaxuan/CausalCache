  "scientific_contract": {
    "question": "whether_a_structural_pair_residual_can_reduce_the_additive_selector_gap_without_reopening_v1",
    "utility": "U(S)=D(empty)-D(S)",
    "singleton_target": "U_i=U({i})",
    "pair_residual_target": "R_ij=U({i,j})-U({i})-U({j})",
    "pair_utility_target": "U_ij=U({i,j})",
    "pair_index_rule": "chronological_event_step_i_strictly_less_than_j",
    "chronology_interpretation": "deterministic_parameterization_not_a_claim_that_interaction_is_directional",
    "candidate_event_maximum": 4,
    "budget": 2,
    "maximum_feasible_subset_count": 11,
    "maximum_count_formula": "1+n+choose(n,2)_at_n=4",
    "policy_rerun_count": 0,
    "restoration_label_regeneration_count": 0
  },
  "model_contract": {
    "input_dtype": "float32",
    "event_input_dimension": 200,
    "query_dimension": 64,
    "event_encoder": {
      "layers": ["Linear(200,64)", "GELU(approximate=none)"],
      "output_dimension": 64
    },
    "singleton_head": {
      "layers": ["Linear(64,1)"],
      "output": "scaled_raw_singleton_utility"
    },
    "pair_features": {
      "canonical_order": "event_step_i_strictly_less_than_j",
      "concatenation": ["z_i", "z_j", "z_i_times_z_j", "abs_z_i_minus_z_j", "q64"],
      "dimension": 320
    },
    "pair_residual_head": {
      "layers": ["Linear(320,64)", "GELU(approximate=none)", "Linear(64,1)"],
      "output": "scaled_raw_pair_residual"
    },
    "pair_prediction": "Uhat_ij=Uhat_i+Uhat_j+Rhat_ij",
    "empty_prediction": 0.0,
    "chronological_pair_features_are_intentionally_not_permutation_invariant": true,
    "iterative_conditional_mlp_reused": false
  },
  "training_contract": {
    "device": "cpu",
    "dtype": "float32",
    "learning_rates_in_grid_order": [0.0003, 0.001],
    "seeds_in_grid_order": [0, 1, 2, 3, 4],
    "maximum_epochs": 500,
    "patience_epochs": 50,
    "epoch_improvement_epsilon": 0.0001,
    "fold_count": 5,
    "heldout_state_rule": "unique_n4_B2_state_per_trajectory",
    "target_scaling": {
      "scope": "fold_training_partition_only",
      "formula": "sqrt((equal_mean_Ui_squared+equal_mean_Uij_squared+equal_mean_Rij_squared)/3)",
      "equal_weight_order": "trajectory_then_state_then_rows_within_target_family",
      "minimum_scale": 1e-12,
      "heldout_or_fresh_values_may_fit_scale": false
    },
    "loss": {
      "singleton": "equal_weight_SmoothL1(Uhat_i_scaled,U_i_scaled,beta=1)",
      "pair_utility": "equal_weight_SmoothL1(Uhat_ij_scaled,U_ij_scaled,beta=1)",
      "pair_residual": "equal_weight_SmoothL1(Rhat_ij_scaled,R_ij_scaled,beta=1)",
      "regression": "(L_singleton+L_pair_utility+L_pair_residual)/3",
      "all_feasible_set_ranking": "equal_weight_softplus(-sign(U_left-U_right)*(Uhat_left-Uhat_right))",
      "ranking_comparisons": "all_unordered_pairs_among_empty_singletons_pairs",
      "ranking_equal_weight_order": "trajectory_then_state_then_untied_comparison",
      "ranking_raw_tie_epsilon": 1e-12,
      "ranking_weight": 0.25,
      "normalized_regression_weight": 0.0,
      "extra_sign_loss_weight": 0.0
    },
    "rejected_ablations": [
      "v1_iterative_conditional_mlp",
      "fresh16_fitted_scale",
      "normalized_only_regression_due_to_small_denominator_amplification",
      "extra_sign_loss_that_duplicates_all_set_ranking"
    ],
    "single_seed_early_stop_and_lr_selection_variant": "unguarded_pair_residual",
    "epoch_selection_metric": "minimum_of_n4_raw_utility_over_exact_and_n4_normalized_recovery_over_exact",
    "learning_rate_selection_metric": "five_seed_mean_selected_epoch_metric",
    "learning_rate_tie_epsilon": 0.0001,
    "learning_rate_tie_choice": 0.0003,
    "final_fit_scope": "all_formal58_trajectories",
    "checkpoint_count": 5,
    "checkpoint_format": "safetensors",
    "ensemble_variants_formed_only_after_all_five_final_seed_checkpoints": true,
    "bootstrap": {
      "unit": "trajectory",
      "resamples": 10000,
      "confidence": 0.9,
      "interval": "percentile",
      "seed": 271828
    }
  },
  "selection_contract": {
    "feasible_sets": "empty_plus_all_singletons_plus_all_pairs",
    "enumeration": "exact_over_learned_set_utility_without_policy_rerun",
    "tie_break": ["higher_predicted_utility", "lower_cardinality", "lexicographically_lower_event_step_ids"],
    "tie_epsilon": 0.0,
    "variants": [
      {
        "name": "additive",
        "definition": "five_seed_mean_singleton_predictions_and_zero_pair_residual"
      },
      {
        "name": "unguarded_pair_residual",
        "definition": "five_seed_mean_singleton_and_pair_residual_predictions"
      },
      {
        "name": "safe_pair_residual",
        "definition": "use_ensemble_pair_candidate_only_with_four_of_five_seed_argmax_agreement_and_four_of_five_strictly_positive_seed_margins_else_additive_fallback"
      }
    ],
    "safe_pair_candidate": "argmax_of_five_seed_mean_unguarded_set_utility",
    "safe_base_candidate": "argmax_of_five_seed_mean_additive_set_utility",
    "safe_vote_threshold": 4,
    "safe_vote_total": 5,
    "safe_positive_margin_threshold": 4,
    "safe_positive_margin_definition": "individual_seed_F_m(pair_candidate)-F_m(base_candidate)_strictly_greater_than_zero",
    "safe_identical_candidate_rule": "if_pair_candidate_equals_base_candidate_return_that_subset_without_switch_test",
    "fallback": "five_seed_mean_additive_exact_enumeration",
    "primary_selector": "safe_pair_residual",
    "safe_selector_does_not_participate_in_single_seed_early_stopping": true,
    "safe_trace_required_fields": [
      "pair_candidate",
      "base_candidate",
      "seedwise_unguarded_argmax",
      "seedwise_pair_minus_base_margins",
      "pair_candidate_vote_count",
      "strictly_positive_margin_count",
      "used_pair_candidate"
    ],
    "all_variants_sealed_before_fresh_label_access": true
  },
  "evaluation_contract": {
    "formal_oof_primary_metrics": [
      "n4_raw_utility_over_exact_subset_oracle",
      "n4_normalized_recovery_over_exact_subset_oracle",
      "minimum_of_the_two_ratios"
