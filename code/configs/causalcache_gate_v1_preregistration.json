    "normalization_epsilon": 1e-12,
    "normalization_eligibility": "D(empty)>1e-12",
    "target_clipping": false,
    "conditional_target": "normalized_raw_conditional_target",
    "independent_raw_projection": "0.5*(raw_Delta_j(empty)+mean_i_not_j(raw_Delta_j({i})))",
    "independent_target": "independent_raw_projection/max(D(empty),1e-12)",
    "independent_targets_per_state_candidate": 1,
    "independent_projection_repeated_on_conditional_edges": false,
    "small_Dempty_state_rule": "exclude_only_from_normalized_regression_and_normalized_means_retain_raw_target_ranking_sign_raw_evaluation_and_count",
