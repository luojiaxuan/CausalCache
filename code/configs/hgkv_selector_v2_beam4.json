    "b4": {
      "comparators": [
        "recent",
        "ocr_rgb_similarity",
        "random"
      ],
      "pass": "all_paired_ci_lower_bounds_strictly_greater_than_zero"
    },
    "average_b1_b2_b4": {
      "comparison": "hgkv_v2_beam4_minus_recent",
      "pass": "paired_ci_lower_bound_strictly_greater_than_zero"
    },
    "closed_loop_requires_offline_gate_pass": true
  }
