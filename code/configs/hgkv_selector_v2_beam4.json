      "edge1": "U({i,j}) - U({i})",
      "edge2": "U({i,j,k}) - U({i,j})",
      "edge3": "U({i,j,k,l}) - U({i,j,k})"
    },
    "stop_marginal": 0.0,
    "stop_is_optimal": "max_candidate_marginal_le_zero",
    "budget_replication": {
      "depth0": [
        1,
        2,
        4
      ],
      "depth1": [
        1,
        3
      ],
      "depth2": [
        2
      ],
      "depth3": [
        1
      ]
    }
  },
  "student": {
    "search": "learned_beam4",
    "beam_width": 4,
    "max_budget": 4,
    "fresh_initialization": true,
    "use_stage1_checkpoint": false,
    "candidate_encoder": {
      "hidden_dim": 64,
      "head_hidden_dim": 32,
      "temporal_hidden_dim": 16
    },
    "set_conditioning": {
      "selected_set_attention_blocks": 1,
      "candidate_to_selected_attention_blocks": 1,
      "attention_heads": 4,
      "empty_selected_token": "learned"
    },
    "outputs": [
      "conditional_marginal",
      "within_prefix_rank",
      "positive",
      "stop"
    ],
    "beam_pruning_score": "cumulative_calibrated_marginal",
    "rank_scope": "within_prefix_and_candidate_vs_stop_only",
    "dynamic_candidate_padding": true,
    "maximum_selected_width": 3
  },
  "training": {
    "group_unit": "prefix",
    "candidate_loss_reduction": "mean_within_prefix_then_mean_across_prefixes",
    "split_group": "trajectory",
    "selection": "train_only_group_kfold_5_then_median_epoch_full_train_refit",
    "checkpoint_metric": "teacher_forced_learned_beam4_realized_u",
    "development_read_policy": "once_after_epoch_selection_and_full_train_refit",
    "folds": 5,
    "max_epochs": 30,
    "patience": 5,
    "batch_groups": 64,
    "learning_rate": 0.0003,
